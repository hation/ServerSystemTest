<hc:Window x:Class="FirpeCleaner.ConfirmDialog"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="危险操作确认"
           Width="460" SizeToContent="Height"
           WindowStartupLocation="CenterOwner"
           ShowInTaskbar="False" ResizeMode="NoResize"
           FontSize="{StaticResource FontSize.Body}"
           Background="{DynamicResource BackgroundBrush}">
  <StackPanel Margin="{StaticResource Spacing.L}">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap"
               Foreground="{DynamicResource PrimaryTextBrush}"
               Margin="{StaticResource Spacing.XS}"/>
    <TextBlock x:Name="RequiredText" TextWrapping="Wrap"
               Foreground="{DynamicResource SecondaryTextBrush}"
               FontSize="{StaticResource FontSize.Caption}"
               Margin="{StaticResource Spacing.XS}"/>
    <hc:TextBox x:Name="InputBox" Margin="{StaticResource Spacing.S}"
                FontSize="{StaticResource FontSize.Body}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="{StaticResource Spacing.S}">
      <Button Content="取消" Width="90" Height="32" Click="Cancel_Click"
              Style="{StaticResource ButtonDefault}"
              Margin="{StaticResource Spacing.XS}"/>
      <Button Content="执行" Width="90" Height="32" Click="Ok_Click"
              Style="{StaticResource ButtonDanger}"
              Foreground="{StaticResource ButtonTextBrush}"
              Margin="{StaticResource Spacing.XS}"/>
    </StackPanel>
  </StackPanel>
</hc:Window>
