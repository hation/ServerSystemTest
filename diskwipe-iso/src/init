#!/bin/sh
# diskwipe-iso initramfs 启动脚本（PID 1 入口）：
#   挂载 /proc /sys /dev → busybox modprobe 白名单磁盘驱动 → mdev -s 扫描设备
#   → sleep 10 等待设备稳定（v1.5.7：去掉重试 mdev 轮询；v1.5.10 加长——mpt3sas
#   SAS 盘扫描需数秒，menu 枚举前需就绪；U 盘已不绑定，等待期间无 I/O 阻塞风险；
#   v1.5.13：25 → 10 缩短——SAS 盘扫描数秒即可，盘是否就绪由 menu 持续重试兜底）
#   → rmmod 卸载 usb-storage/uas（v1.5.17：SAS 盘带出后卸载防 U 盘卡死）
#   → exec menu.sh（交互菜单）。
# v1.5.6 语义：进度走 /dev/kmsg（内核 printk 通道，与内核日志混排，真机 KVM 屏幕最后几行
#   可见）+ timeout 5 兜底（用户态挂起自动跳过）——仅挂载失败进入救援 shell；模块加载/mdev
#   失败仅 WARN 继续（驱动缺失由 menu 盘列表体现）。注意：内核 D 状态（不可中断 I/O）用户态
#   timeout 无效，若仍卡则靠 kmsg 进度行定位卡点模块。
# v1.5.7 语义：去掉设备重试扫描（真机 U 盘枚举后重试 mdev 触发 U 盘 I/O 阻塞——内核 D 状态
#   不可中断、用户态 timeout 无效——致 init 卡死、menu 永不启动）；改为仅 sleep 等待设备稳定，
#   U 盘设备节点由 menu 退出写日志前 dw_save_log_to_usb 内 mdev -s 补建（失败降级 WARN）。
#
# v1.3.2 关键设计：init 阶段**零 U 盘 I/O**——不挂载日志介质、不写测试、不做 U 盘探测。
# 真机实测 U 盘 I/O 阻塞（内核 D 状态，timeout 亦杀不掉）会导致 init 卡死、菜单永不出现；
# 日志改为全程写内存（tmpfs），仅在 menu 退出时由 dw_save_log_to_usb 尽力写 U 盘一次
# （此时若仍阻塞属可接受，清理已完成，提示抄录后断电）。
#
# 硬约束：
#   - POSIX/ash 兼容（initramfs 运行时只有 busybox ash；禁止 [[ ]]、数组、${var:0:3} 等
#     bash 专属语法），LF 行尾，中文注释。
#   - 只做启动编排；交互/清除逻辑由 menu.sh/wipe.sh/lib.sh 保证。
#   - 模块白名单覆盖主流服务器磁盘控制器（AHCI/NVMe/LSI/板载 RAID/虚拟化/USB3 等）与
#     USB 存储驱动（usb_storage/uas——v1.5.17 恢复：加载触发 SCSI 扫描带出 SAS 盘，
#     就绪后卸载防 U 盘 I/O 卡死；无 U 盘时加载亦无害），
#     依赖模块由 busybox modprobe 按 modules.dep 自动带入。
#   - 测试经 INIT_PATH 接缝变量注入假件（mount/modprobe/mdev 只记录调用，不真挂载）。

# PATH 兜底：内核 exec PID 1 时不保证 PATH，显式设置；测试可用 INIT_PATH 覆盖注入假件
export PATH="${INIT_PATH:-/bin:/sbin:/usr/bin:/usr/sbin}"

# v1.5.6：进度走 /dev/kmsg（内核 printk 通道）——与内核日志混排，真机 KVM 屏幕
# 最后几行可见（普通 echo 到 /dev/console 在 fbcon 切换前的输出被丢弃/滚动覆盖）。
dw_progress() { echo "diskwipe-init: $*" > /dev/kmsg 2>/dev/null; }

# 加载共享库（dw_version 等；接缝变量 LSBLK_BIN/BLKID_BIN/UMOUNT_BIN 随 PATH 解析）
. "$(dirname "$0")/lib.sh"

# 磁盘驱动模块白名单（按此字符串逐模块加载）。
# usb_storage/uas：v1.5.17 恢复——usb-storage 加载触发 SCSI 总线扫描/事件使 mpt3sas
#   控制器完成初始化并带出 SAS 盘（v1.5.6 唯一 sda 识别成功的配置；v1.5.9 去掉后 sda
#   再未出现）；设备就绪后由下方 rmmod 卸载（防 v1.5.7/1.5.8 U 盘 I/O 卡死）。
# nls_iso8859-1/exfat/ntfs3：vfat 挂载需 iocharset 模块；exfat/ntfs3 为模块（Ventoy
#   数据区/Windows U 盘退出写日志需要；无对应设备时加载亦无害）
DRIVE_MODULES="ahci libahci libata nvme nvme-core mpt3sas megaraid_sas virtio_blk virtio_pci xhci_pci sd_mod scsi_mod usb_storage uas nls_iso8859-1 exfat ntfs3"
# Kylin 4.19 内核（v1.4.0 起 uname -r 含 ky10 时切换）适配：
#   - xhci_pci/usbcore/ehci/ohci/scsi_mod/virtio_pci/virtio 为内核内建（modules.builtin，
#     无模块文件可加载——这正是 Kylin 内核在该海光服务器 USB 栈兼容的关键）；白名单剔除
#     （modprobe 内建模块名可能告警，避免误进救援 shell）；
#   - exfat/ntfs3：Kylin 4.19 未引入，无模块（剔除；缺失不中断——构建侧同样跳过）；
#   - usb-storage：Kylin 模块文件名为 usb-storage.ko（busybox modprobe 按 modules.dep
#     路径解析，usb_storage 与 usb-storage 均能命中，这里用文件名形态）；
#   - vfat/fat：Kylin 中为模块（Ubuntu 24.04 为内建），退出写日志 U 盘 vfat 挂载需要
#     （vfat 依赖 fat，busybox modprobe 按 modules.dep 自动带入）；
#   - 依赖链（nvme→nvme-core→nvme-common、ahci→libahci→libata、
#     mpt3sas→raid_class+scsi_transport_sas）由 busybox modprobe 读 modules.dep 自动加载，
#     构建侧 dw_modules_kylin 已按同一清单 + 依赖链提取对应 .ko 进 initramfs。
case "$(uname -r 2>/dev/null)" in
*ky10*)
    # v1.5.17 恢复 usb-storage + uas（文件名形态 usb-storage.ko——busybox modprobe 按
    # modules.dep 解析，usb_storage 与 usb-storage 均能命中）——v1.5.6 唯一 sda 识别成功
    # 的配置：usb-storage 加载触发 SCSI 总线扫描/事件带出 SAS 盘（v1.5.9 去掉后 sda 再未
    # 出现）。v1.5.8 曾去掉 uas（UAS 绑定 ASolid U 盘协议异常 D 状态卡死）、v1.5.9 曾去掉
    # usb-storage（U 盘绑定读盘触发内核 I/O 阻塞）——v1.5.17 以「就绪后卸载」化解
    # （SAS 盘带出后 rmmod usb-storage uas，见 settle wait 之后；卸载失败不阻断）。
    DRIVE_MODULES="ahci libahci libata nvme nvme-core mpt3sas megaraid_sas virtio_blk sd_mod usb-storage uas nls_iso8859-1 vfat fat"
    ;;
esac

# 启动失败：打印错误并停留在救援 shell（不 exec menu.sh，便于现场诊断）
init_rescue() {
    echo "ERROR: $1"
    echo "Stuck at rescue shell (run commands to diagnose; type exit to quit)..."
    exec sh
    # exec 失败（极端情况）时以非 0 终止，避免带病继续启动
    exit 1
}

# 1) 挂载基础文件系统（busybox mount；/dev 用 devtmpfs，mdev 再补设备节点）
mount -t proc proc /proc || init_rescue "mount /proc failed"
echo "Mounted /proc"
mount -t sysfs sysfs /sys || init_rescue "mount /sys failed"
echo "Mounted /sys"
mount -t devtmpfs devtmpfs /dev || init_rescue "mount /dev failed"
echo "Mounted /dev"

# 2) 逐模块加载磁盘驱动白名单（v1.5.6：进度走 kmsg + timeout 5 兜底；失败仅 WARN 继续——
#    不再 init_rescue，保证到菜单，驱动缺失由 menu 盘列表体现；原 rescue 语义仅保留给 mount）
for im in $DRIVE_MODULES; do
    dw_progress "loading module $im"
    # v1.5.16 修复：mpt3sas 默认 max_queue_depth=32455，高核数服务器（海光）+ initramfs
    # 内存受限时内核无法分配大队列内存 → scsih_probe 失败 → 控制器不初始化、盘不识别
    # （Fedora/Broadcom 已知问题）。传 max_queue_depth=10000 降低内存需求（官方方案）。
    if [ "$im" = "mpt3sas" ]; then
        timeout 5 modprobe mpt3sas max_queue_depth=10000 2>/dev/null || echo "WARN: module mpt3sas load failed/timed out"
    else
        timeout 5 modprobe "$im" 2>/dev/null || echo "WARN: module $im load failed/timed out"
    fi
done
dw_progress "Disk driver modules loaded"

# v1.5.15 修复：SCSI 驱动（mpt3sas/megaraid_sas）加载后强制重扫描全部 scsi_host——
# 真机 SAS 盘未被自动扫描带出（lsblk 空）；echo "- - -" 触发一次完整 rescan，
# 确保盘被内核创建。逐个写、失败跳过（部分 host 非 SCSI 扫描型）。
for sh in /sys/class/scsi_host/host*/scan; do
    [ -w "$sh" ] && echo "- - -" > "$sh" 2>/dev/null || true
done

# 2.5) v1.5.4 显卡驱动：内核自探测显卡硬件 → DRM → fbcon → tty0 显示（不依赖 GRUB framebuffer；
# 真机 UEFI 下 GRUB 视频初始化失败无 framebuffer，靠显卡驱动重建显示）。
# v1.5.6：显卡循环只加载 ast（真机 AST2500）。mgag200/smifb/bochs-drm/cirrus/
# virtio-gpu 在无对应硬件时 modprobe 可能内核 D 状态挂起（用户态 timeout 无效），
# 导致 init 卡死（真机实证 sdb 枚举后无输出）；需要时按机器单独加入白名单。
dw_progress "loading video module ast"
timeout 5 modprobe ast 2>/dev/null

# v1.5.11：确保 USB 键盘/鼠标（HID）驱动加载（内建则 modprobe 跳过无碍；模块则加载）。
# 真机 KVM USB 键盘需 usbhid 才能输入。
dw_progress "loading HID drivers (usbhid)"
timeout 5 modprobe usbhid 2>/dev/null

# 3) mdev -s 扫描并创建设备节点（v1.5.6：timeout 5 + kmsg 进度；失败仅 WARN，不 rescue）
dw_progress "device scan (mdev -s)"
timeout 5 mdev -s || echo "WARN: mdev scan failed/timed out"
dw_progress "Device nodes scanned"

# 4) 等待设备稳定（v1.5.7：去掉设备重试扫描（mdev -s 轮询）——真机 U 盘枚举后重试
#    mdev 触发 U 盘 I/O 阻塞（内核 D 状态，用户态 timeout 无效）致 init 卡死。改为仅
#    sleep 等待设备稳定；U 盘设备节点由 menu 退出写日志前 dw_save_log_to_usb 内
#    mdev -s 补建（失败降级）。
# v1.5.10：加长等待（sleep 3 → 10）——真机 mpt3sas 14.47s 才加载、SAS 盘扫描需数秒，
#   若 menu 过早枚举（sleep 3 后 15.45s）lsblk 为空 → 误判"仅启动介质"；U 盘已不绑定，
#   等待期间无 I/O 阻塞风险（不读盘、不触发内核 D 状态）。
# v1.5.11：再加长（sleep 10 → 25）——真机日志实证 SAS 盘（sda）从驱动加载到 lsblk 可
#   枚举约需 25 秒，重试 3 轮（每轮 sleep 5）仍全部枚举不到（直到 reboot 未生效、menu
#   继续跑后才列出盘）；等待足够长，避免无盘重试误判拖到自动 reboot。
# v1.5.13：缩短回 10（等待煎熬；SAS 盘扫描数秒即可，盘是否就绪由 menu 无盘无限重试兜底
#   ——盘迟就绪也只是多等几个 5s 重试周期，绝不自动关机/重启）。
dw_progress "device settle wait (sleep)"
sleep 10

# v1.5.17：SAS 盘已带出（usb-storage 加载触发 SCSI 扫描），卸载 usb-storage/uas——
# U 盘设备已绑定，退出写日志 U 盘不再需要（日志降级内存+屏幕），卸载消除 U 盘 I/O 阻塞
# （v1.5.7/1.5.8 卡死根源；busybox rmmod 支持多模块与 '-'→'_' 模块名转换——Kylin
# usb-storage.ko 运行时模块名为 usb_storage）。卸载失败不阻断（无 U 盘时 usb-storage
# 仍加载、卸载亦无害）。
rmmod usb-storage uas 2>/dev/null || true

# 5) 进入交互菜单（exec 替换自身；v1.5.8 加诊断：exec 前后进度，失败兜底救援 shell）
dw_progress "exec menu.sh"
exec "$(dirname "$0")/menu.sh" || {
    dw_progress "exec menu.sh FAILED"
    dw_progress "argv0=$0 dirname=$(dirname "$0")"
    exec sh
}
