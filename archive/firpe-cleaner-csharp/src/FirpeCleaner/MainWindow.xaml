<hc:Window x:Class="FirpeCleaner.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="FirPE Disk Cleaner"
           Width="1180" Height="800" MinWidth="760" MinHeight="520"
           WindowStartupLocation="CenterScreen"
           FontSize="{StaticResource FontSize.Body}"
           Closing="Window_Closing">
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.RowDefinitions>
      <!-- 顶部盘列表区（*，占主体）→ 中部操作区（Auto）→ 底部状态栏（Auto）→ 日志区（Auto，收窄为少量行） -->
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ========== 盘列表区 ========== -->
    <Border Grid.Row="0" Margin="{StaticResource Spacing.M}"
            Background="{DynamicResource RegionBrush}"
            CornerRadius="{StaticResource CornerRadius.Standard}">
      <Grid Margin="{StaticResource Spacing.M}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="DiskCountTitle" Text="Disks to clean"
                   FontSize="{StaticResource FontSize.Subtitle}"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <DataGrid Grid.Row="1" x:Name="DiskGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  VerticalScrollBarVisibility="Auto"
                  RowHeight="30"
                  MinHeight="140"
                  Margin="{StaticResource Spacing.S}">
          <DataGrid.Columns>
            <!-- 勾选列：模板 CheckBox（只读 DataGrid 下模板列控件仍可交互）；
                 排除盘 IsEnabled=false（IsExcluded 为 true 时禁用） -->
            <DataGridTemplateColumn Header="Pick" Width="60">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            IsEnabled="{Binding CanClean}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Disk" Binding="{Binding DiskName}" Width="150"/>
            <DataGridTextColumn Header="Bus" Binding="{Binding Bus}" Width="90"/>
            <DataGridTextColumn Header="Size (GB)" Binding="{Binding SizeGB}" Width="100"/>
            <DataGridTextColumn Header="Free (GB)" Binding="{Binding FreeText}" Width="100"/>
            <!-- 状态列：可清理 / 排除原因（排除原因经 DiskRow 映射为纯 ASCII） -->
            <DataGridTemplateColumn Header="Status" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <!-- 空状态提示：无盘或全部排除时显示（不遮挡列头，识别到可清理盘后自动消失） -->
        <Border Grid.Row="2" x:Name="EmptyState" Visibility="Collapsed"
                Background="{DynamicResource SecondaryRegionBrush}"
                CornerRadius="{StaticResource CornerRadius.Small}"
                Margin="{StaticResource Spacing.S}" Padding="{StaticResource Spacing.S}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="No cleanable disk found." FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="  USB / CD / removable disks are excluded automatically."
                       Margin="{StaticResource Spacing.S}" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ========== 操作区 ========== -->
    <Border Grid.Row="1" Margin="{StaticResource Spacing.M}" Padding="{StaticResource Spacing.S}"
            Background="{DynamicResource RegionBrush}"
            CornerRadius="{StaticResource CornerRadius.Standard}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Cleaning removes all partitions and resets the disk to uninitialized state. This cannot be undone."
                   TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="{StaticResource Spacing.S}"/>
        <Button Grid.Column="1" x:Name="CleanBtn" Content="Clean Selected Disks"
                Style="{StaticResource ButtonDanger}"
                Foreground="{StaticResource ButtonTextBrush}"
                Width="190" Height="36" IsEnabled="False"
                Click="Clean_Click" Margin="{StaticResource Spacing.S}"/>
      </Grid>
    </Border>

    <!-- ========== 状态栏 ========== -->
    <Border Grid.Row="2" Background="{DynamicResource SecondaryRegionBrush}"
            Padding="{StaticResource Spacing.S}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Status:" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Grid.Column="1" x:Name="StatusText" Text="Ready" MinWidth="200" VerticalAlignment="Center"
                   Margin="{StaticResource Spacing.XS}"/>
        <Button Grid.Column="2" x:Name="ThemeBtn" Content="Theme: Light" Height="30"
                Click="ThemeBtn_Click" Margin="{StaticResource Spacing.XS}"/>
      </Grid>
    </Border>

    <!-- ========== 日志区 ========== -->
    <Border Grid.Row="3" Margin="{StaticResource Spacing.M}" Padding="{StaticResource Spacing.S}"
            Background="{DynamicResource RegionBrush}"
            CornerRadius="{StaticResource CornerRadius.Standard}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Log" FontSize="{StaticResource FontSize.Subtitle}"
                   Margin="{StaticResource Spacing.XS}"/>
        <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" Margin="{StaticResource Spacing.XS}" MaxHeight="110"/>
      </Grid>
    </Border>

    <!-- ========== Growl 宿主（静态 Growl.* 的显示容器；右下角从下往上堆叠）。
         HandyControl 3.5.1 无 GrowlPanel 控件，官方做法：StackPanel + hc:Growl.GrowlParent="True" -->
    <StackPanel x:Name="growlPanel" hc:Growl.GrowlParent="True"
                Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="{StaticResource Spacing.S}"/>
  </Grid>
</hc:Window>
