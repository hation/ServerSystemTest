<hc:Window x:Class="FirpeCleaner.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="FirpeCleaner — FirPE 一键清盘（脚手架）"
           Width="1180" Height="800"
           FontSize="{StaticResource FontSize.Body}"
           Background="{DynamicResource BackgroundBrush}"
           Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ 主内容 ============ -->
    <hc:TabControl Grid.Row="0" Margin="{StaticResource Spacing.M}">
      <hc:TabItem Header="任务">
        <!-- 内容可滚动：窗口被屏幕收窄后（高 DPI）日志卡仍能滚动看到；
             Background=BackgroundBrush：卡片本体是白色，若背景也是白则卡片间隙视觉隐形（"贴在一起"） -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource BackgroundBrush}">
          <Grid Margin="{StaticResource Spacing.M}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 参数卡 -->
            <hc:Card Grid.Row="0" Header="参数" Margin="{StaticResource Spacing.XS}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="参数" VerticalAlignment="Center" Margin="{StaticResource Spacing.S}"/>
                <hc:TextBox x:Name="ParamBox" Width="200" Text="demo" Margin="{StaticResource Spacing.S}"/>
                <CheckBox x:Name="DryRunCheck" Content="DryRun（只预览不执行）"
                          VerticalAlignment="Center" Margin="{StaticResource Spacing.S}"/>
                <Button x:Name="StartBtn" Content="开始任务" Style="{StaticResource ButtonPrimary}"
                        Foreground="{StaticResource ButtonTextBrush}"
                        Width="110" Height="34" Click="Start_Click" Margin="{StaticResource Spacing.S}"/>
                <Button x:Name="StopBtn" Content="停止" Style="{StaticResource ButtonDanger}"
                        Foreground="{StaticResource ButtonTextBrush}"
                        Width="90" Height="34" IsEnabled="False" Click="Stop_Click" Margin="{StaticResource Spacing.S}"/>
              </StackPanel>
            </hc:Card>

            <!-- 危险操作演示卡（强确认） -->
            <hc:Card Grid.Row="1" Header="危险操作演示（强确认）" Margin="{StaticResource Spacing.XS}">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="DangerBtn" Content="执行清理（需输入「确认执行」）" Style="{StaticResource ButtonDanger}"
                        Foreground="{StaticResource ButtonTextBrush}"
                        Width="260" Height="34" Click="Danger_Click" Margin="{StaticResource Spacing.XS}"/>
                <TextBlock Text="真实项目此处改为 run_erase.ps1 / run_reset.ps1 等" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="{StaticResource Spacing.S}"/>
              </StackPanel>
            </hc:Card>

            <!-- 日志卡 -->
            <hc:Card Grid.Row="2" Header="运行日志" Margin="{StaticResource Spacing.M}">
              <hc:TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                          VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                          Margin="{StaticResource Spacing.XS}"/>
            </hc:Card>
          </Grid>
        </ScrollViewer>
      </hc:TabItem>
    </hc:TabControl>

    <!-- ============ 状态栏 ============ -->
    <Border Grid.Row="1" Background="{DynamicResource SecondaryRegionBrush}" Padding="{StaticResource Spacing.S}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="StageText" Text="待命" MinWidth="80" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" x:Name="BatchText" Text="-" MinWidth="150" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <ProgressBar Grid.Column="2" x:Name="ProgressBar" Minimum="0" Maximum="1" Value="0" Height="8"
                     VerticalAlignment="Center" Margin="{StaticResource Spacing.S}"/>
        <TextBlock Grid.Column="3" x:Name="ProgressText" Text="0/3" MinWidth="48" VerticalAlignment="Center"/>
        <Button Grid.Column="4" x:Name="OpenResultBtn" Content="打开结果" Height="32"
                Click="OpenResult_Click" Margin="{StaticResource Spacing.XS}"/>
        <Button Grid.Column="5" x:Name="ThemeBtn" Content="主题：浅色" Height="32"
                Click="ThemeBtn_Click" Margin="{StaticResource Spacing.XS}"/>
      </Grid>
    </Border>
  </Grid>
</hc:Window>
