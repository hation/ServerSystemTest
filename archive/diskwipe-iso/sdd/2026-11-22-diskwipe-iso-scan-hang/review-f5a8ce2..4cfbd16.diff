+                for (i=4; i<=NF; i++) { if ($i ~ /^\//) { mps=$i; for (j=i+1; j<=NF; j++) mps=mps " " $j; break } }
+                pk=""
+                if (type != "disk") {
+                    pk=name
+                    if (pk ~ /p[0-9]+$/) sub(/p[0-9]+$/, "", pk)
+                    else while (pk ~ /[0-9]$/) pk=substr(pk,1,length(pk)-1)
+                }
+                printf "%s %s %s %s %s %s\n", name, type, mps, pk, pt[name], fl[name]
+            }' "$ROOT/lsblk.table"
+        ;;
     esac
     ;;
 -no)
     case "$2" in
     PARTFLAGS)
         dev="${3#/dev/}"
         [ -f "$ROOT/lsblk.flags" ] || exit 0
         awk -v d="$dev" '$1==d { print $2 }' "$ROOT/lsblk.flags"
         ;;
     PARTTYPENAME)
diff --git a/diskwipe-iso/tests/t3_init.sh b/diskwipe-iso/tests/t3_init.sh
index 4fa9281..e697689 100644
--- a/diskwipe-iso/tests/t3_init.sh
+++ b/diskwipe-iso/tests/t3_init.sh
@@ -31,20 +31,24 @@ setup_stub() {
     mkdir -p "$ROOT/stub"
