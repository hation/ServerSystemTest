<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 间距阶梯 ===== -->
    <Thickness x:Key="Spacing.XS">4</Thickness>
    <Thickness x:Key="Spacing.S">8</Thickness>
    <Thickness x:Key="Spacing.M">16</Thickness>
    <Thickness x:Key="Spacing.L">24</Thickness>
    <Thickness x:Key="Spacing.XL">32</Thickness>

    <!-- ===== 字号阶梯 ===== -->
    <sys:Double x:Key="FontSize.Title"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="FontSize.Body"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSize.Caption"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>

    <!-- ===== 圆角 ===== -->
    <CornerRadius x:Key="CornerRadius.Standard">8</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Small">4</CornerRadius>

    <!-- ===== 按钮文字色 =====
         HandyControl 的 ButtonPrimary/ButtonDanger 只设背景不设前景，
         默认黑字压蓝/红底，必须显式引用 ButtonTextBrush（白色）。 -->
    <SolidColorBrush x:Key="ButtonTextBrush" Color="White"/>

    <!-- ===== 全局隐式样式：字体 ===== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    </Style>

</ResourceDictionary>
