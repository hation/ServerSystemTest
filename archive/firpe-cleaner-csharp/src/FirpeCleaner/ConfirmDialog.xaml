<hc:Window x:Class="FirpeCleaner.ConfirmDialog"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="Confirm Clean"
           Width="560" SizeToContent="Height"
           WindowStartupLocation="CenterOwner"
           ShowInTaskbar="False" ResizeMode="NoResize"
           FontSize="{StaticResource FontSize.Body}"
           Background="{DynamicResource BackgroundBrush}">
  <StackPanel Margin="{StaticResource Spacing.L}">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap"
               Foreground="{DynamicResource PrimaryTextBrush}"
               Margin="{StaticResource Spacing.XS}"/>
    <!-- 选中盘清单（盘号/型号/容量），超出高度可滚动 -->
    <Border Background="{DynamicResource SecondaryRegionBrush}"
            CornerRadius="{StaticResource CornerRadius.Small}"
            Margin="{StaticResource Spacing.S}" Padding="{StaticResource Spacing.S}">
      <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="DiskList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="{StaticResource Spacing.XS}"
                         Foreground="{DynamicResource PrimaryTextBrush}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <TextBlock Text="This operation cannot be undone."
               Foreground="{DynamicResource DangerBrush}"
               Margin="{StaticResource Spacing.XS}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="{StaticResource Spacing.S}">
      <Button Content="Cancel" Width="90" Height="32" Click="Cancel_Click"
              Style="{StaticResource ButtonDefault}"
              Margin="{StaticResource Spacing.XS}"/>
      <Button Content="Clean" Width="90" Height="32" Click="Ok_Click"
              Style="{StaticResource ButtonDanger}"
              Foreground="{StaticResource ButtonTextBrush}"
              Margin="{StaticResource Spacing.XS}"/>
    </StackPanel>
  </StackPanel>
</hc:Window>
